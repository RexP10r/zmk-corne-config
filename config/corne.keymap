#include <dt-bindings/led/led.h>

/* 1. Configure the SPI pin for the LEDs (nice_nano_v2 MOSI pin is P0.06) */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>; 
        spi-max-frequency = <4000000>;
        
        chain-length = <21>; 
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/* 2. Tell ZMK to use this LED strip for underglow */
/ {
    chosen {
        zmk,underglow = &led_strip;
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base Layer";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
//                  | GUI | LWR | SPC |   | ENT | RSE | ALT |
            bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
            >;
        };

        lower {
            display-name = "Lower Layer";
// -----------------------------------------------------------------------------------------
// |      |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// |  :   |  "  |  <  |  >  |  ?  |  ~  |   | LFT | DWN |  UP | RGT | DEL | RGB  |
// |      |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | RST  |
//                  |     |     |     |   |     |     |     |
            bindings = <
   &trans    &kp N1   &kp N2 &kp N3   &kp N4    &kp N5     &kp N6    &kp N7   &kp N8    &kp N9    &kp N0   &kp BSPC
   &kp COLON &kp DQT  &kp LT &kp GT   &kp QMARK &kp TILDE  &kp LEFT  &kp DOWN &kp UP    &kp RIGHT &kp DEL  &rgb_ug RGB_TOG
   &trans    &kp EXCL &kp AT &kp HASH &kp DLLR  &kp PRCNT  &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR &sys_reset
                                   &trans &trans &trans   &trans &trans &trans
            >;
        };

        raise {
            display-name = "Raise Layer";
// -----------------------------------------------------------------------------------------
// |      | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 | F11  |
// |      | CUT | COPY|PASTE|     |     |   | HOME| PGDN| PGUP| END |     | F12  |
// |      |  _  |  +  |  {  |  }  |  |  |   |  -  |  =  |  [  |  ]  |  \  |  `   |
//                  |     |     |     |   |     |     |     |
            bindings = <
   &trans    &kp F1    &kp F2     &kp F3      &kp F4   &kp F5     &kp F6    &kp F7    &kp F8   &kp F9    &kp F10  &kp F11
   &trans    &kp K_CUT &kp K_COPY &kp K_PASTE &trans   &trans     &kp HOME  &kp PGDN  &kp PGUP &kp END   &trans   &kp F12
   &trans    &kp UNDER &kp PLUS   &kp LBRC    &kp RBRC &kp PIPE   &kp MINUS &kp EQUAL &kp LBKT &kp RBKT  &kp BSLH &kp GRAVE
                            &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
